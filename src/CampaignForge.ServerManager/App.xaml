<Application x:Class="CampaignForge.ServerManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="Background" Value="#374151" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
