<Window x:Class="CampaignForge.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campaign Forge Server Manager" Height="760" Width="1120"
        MinHeight="650" MinWidth="950" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="CAMPAIGN FORGE" FontSize="13" FontWeight="Bold" Foreground="#60A5FA" />
                <TextBlock Text="Server Control Center" FontSize="29" FontWeight="SemiBold" Margin="0,3,0,0" />
                <TextBlock Text="RALIEN11 · Desktop host" Foreground="{StaticResource MutedBrush}" FontSize="13" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Start Campaign Forge" Background="#166534" Click="StartAll_Click" Padding="18,10" />
                <Button Content="Stop Campaign Forge" Background="#7F1D1D" Click="StopAll_Click" Padding="18,10" />
                <Button Content="Refresh" Click="Refresh_Click" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CpuValue" Text="—" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Whole desktop · system-wide" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="SYSTEM RAM" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="RamValue" Text="—" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="RamDetail" Text="Used / total" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="GPU / VRAM" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="GpuValue" Text="—" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="GpuDetail" Text="NVIDIA status" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="FREE DISK SPACE" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DiskValue" Text="—" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="DiskDetail" Text="C: / D:" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="SERVER COMPONENTS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,10"/>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="SQL Server" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SqlDetail" Text="Checking…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="SqlState" Text="Unknown" Foreground="#FBBF24" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
                        <Button Grid.Column="1" Content="Check / Start if needed" Click="SqlStart_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Ollama Local AI" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="OllamaDetail" Text="Checking…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="OllamaState" Text="Unknown" Foreground="#FBBF24" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Start Ollama" Click="OllamaStart_Click"/><Button Content="Stop Ollama" Click="OllamaStop_Click"/></StackPanel>
                    </Grid>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="15">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Campaign Forge API" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ApiDetail" Text="Checking…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="ApiState" Text="Unknown" Foreground="#FBBF24" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Start API" Click="ApiStart_Click"/><Button Content="Stop API" Click="ApiStop_Click"/></StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="SQL Server is never stopped or reconfigured by this Manager." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="ACTIVITY &amp; HEALTH" FontSize="13" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,10"/>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Height="360">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Manager activity" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBox x:Name="LogBox" Background="#111827" Foreground="#D1D5DB" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                    <StackPanel><TextBlock Text="CURRENT MODEL" FontWeight="SemiBold"/><TextBlock x:Name="ModelValue" Text="No model loaded / not queried" FontSize="15" Margin="0,6,0,0"/><TextBlock Text="Model details are read from Ollama's local API." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="FooterStatus" Text="Ready · Refreshing every 3 seconds" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" Text="Prototype 0.1 · Local desktop only" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
